# Base de datos (Neon Postgres, proyecto NUEVO para kentukianas)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"

# Auth (NextAuth v5)
AUTH_SECRET="genera con: openssl rand -base64 32"
NEXTAUTH_SECRET="mismo valor que AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Vercel Blob (para subir/servir imágenes)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Newsletter + correos transaccionales (Brevo / Sendinblue)
BREVO_API_KEY="xkeysib-xxx"
BREVO_LIST_ID="1"
BREVO_SENDER_EMAIL="remitente-verificado@tudominio.com"
BREVO_SENDER_NAME="Crónicas Kentukianas"

# Login con Google (OAuth). Crear en Google Cloud Console → Credentials.
# Redirect URIs: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
